<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- XenChat Colors -->
    <Color x:Key="Primary">#EE4C49</Color>
    <Color x:Key="PrimaryDark">#D43D3A</Color>
    <Color x:Key="BackgroundDark">#323337</Color>
    <Color x:Key="SurfaceDark">#1B1B1B</Color>
    <Color x:Key="TextPrimary">White</Color>
    <Color x:Key="TextSecondary">#CCCCCC</Color>
    <Color x:Key="TextTertiary">#888888</Color>

    <!-- Keep default colors for compatibility -->
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

</ResourceDictionary>