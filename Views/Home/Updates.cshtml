@{
    ViewData["Title"] = "Updates";
}

<div class="updates-container" style="padding: 32px 40px; max-width: 800px; margin: 0 auto; color: #fff;">
    <h2 style="font-size: 24px; font-weight: 600; margin-bottom: 24px;">Status &amp; Updates</h2>

    <div style="display: flex; flex-direction: column; gap: 16px;">
        <div class="update-card" style="background: #232428; border: 1px solid #333; border-radius: 12px; padding: 20px;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                <h3 style="font-size: 16px; font-weight: 600; color: #ee4c49;">Welcome to XenChat</h3>
                <span style="font-size: 12px; color: #888;">Just now</span>
            </div>
            <p style="font-size: 14px; color: #ccc; line-height: 1.5;">Connect with your team instantly. Send direct messages, view online updates, and collaborate seamlessly.</p>
        </div>

        <div class="update-card" style="background: #232428; border: 1px solid #333; border-radius: 12px; padding: 20px;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                <h3 style="font-size: 16px; font-weight: 600; color: #4CAF50;">System Status: Operational</h3>
                <span style="font-size: 12px; color: #888;">Today</span>
            </div>
            <p style="font-size: 14px; color: #ccc; line-height: 1.5;">Real-time messaging with SignalR and local SQLite database persistence are active and fully operational.</p>
        </div>

        <div class="update-card" style="background: #232428; border: 1px solid #333; border-radius: 12px; padding: 20px;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                <h3 style="font-size: 16px; font-weight: 600; color: #fff;">Upcoming: Channels &amp; Voice Rooms</h3>
                <span style="font-size: 12px; color: #888;">Yesterday</span>
            </div>
            <p style="font-size: 14px; color: #ccc; line-height: 1.5;">Group chats and channel voice rooms are currently in progress. Stay tuned for further updates!</p>
        </div>
    </div>
</div>