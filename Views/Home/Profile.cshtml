@model XenChat.Models.User
@{
    ViewData["Title"] = "Profile";
}

<aside class="profile-page">
    <header class="profile-header">
        <h1>XenChat</h1>
        <div>
            <button type="button" aria-label="Search profile settings">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
            </button>
            <button type="button" aria-label="More profile options">
                <svg width="4" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="5" r="1" />
                    <circle cx="12" cy="12" r="1" />
                    <circle cx="12" cy="19" r="1" />
                </svg>
            </button>
        </div>
    </header>

    <div class="profile-identity">
        <img src="@Model.AvatarPath" alt="@Model.Username" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
        <div class="profile-identity-fallback" style="display:none;">@Model.Initial</div>
        <p>@Model.Username</p>
    </div>

    <div class="profile-content">
        <div class="profile-sections">

            <button class="profile-section" type="button">
                <span class="profile-section-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3" />
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                    </svg>
                </span>
                <span class="profile-section-copy">
                    <span>General</span>
                    <strong>App preferences and startup behavior</strong>
                </span>
            </button>

            <button class="profile-section" type="button">
                <span class="profile-section-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                </span>
                <span class="profile-section-copy">
                    <span>Profile</span>
                    <strong>Personal details, photo and username</strong>
                </span>
            </button>

            <button class="profile-section" type="button">
                <span class="profile-section-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    </svg>
                </span>
                <span class="profile-section-copy">
                    <span>Account</span>
                    <strong>Login, security and account details</strong>
                </span>
            </button>

            <button class="profile-section" type="button">
                <span class="profile-section-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                </span>
                <span class="profile-section-copy">
                    <span>Privacy</span>
                    <strong>Blocked users, message privacy and controls</strong>
                </span>
            </button>

            <button class="profile-section" type="button">
                <span class="profile-section-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                    </svg>
                </span>
                <span class="profile-section-copy">
                    <span>Chat</span>
                    <strong>Chat appearance, themes and settings</strong>
                </span>
            </button>

            <button class="profile-section" type="button">
                <span class="profile-section-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="23 7 16 12 23 17 23 7" />
                        <rect x="1" y="5" width="15" height="14" rx="2" ry="2" />
                    </svg>
                </span>
                <span class="profile-section-copy">
                    <span>Calls</span>
                    <strong>Camera, microphone and audio preferences</strong>
                </span>
            </button>

            <button class="profile-section" type="button">
                <span class="profile-section-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                        <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                    </svg>
                </span>
                <span class="profile-section-copy">
                    <span>Notification</span>
                    <strong>Message alerts and notification preferences</strong>
                </span>
            </button>

            <button class="profile-section" type="button">
                <span class="profile-section-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" />
                        <line x1="12" y1="17" x2="12.01" y2="17" />
                    </svg>
                </span>
                <span class="profile-section-copy">
                    <span>Help &amp; Support</span>
                    <strong>Help center, feedback and important information</strong>
                </span>
            </button>

        </div>

        <a href="@Url.Action("Logout", "Account")" class="profile-logout">
            Logout
        </a>
    </div>
</aside>