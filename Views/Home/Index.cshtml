@model List<XenChat.Models.User>
@{
    ViewData["Title"] = "Chats";
    var currentUserId = Context.Session.GetInt32("UserId");
    var currentUser = ViewBag.CurrentUser;
    var unreadCounts = ViewBag.UnreadCounts as Dictionary<int, int>;
    var lastMessages = ViewBag.LastMessages as Dictionary<int, string>;
    var lastMessageTimes = ViewBag.LastMessageTimes as Dictionary<int, string>;
    var statuses = ViewBag.Statuses as List<XenChat.Models.Status> ?? new List<XenChat.Models.Status>();
    var favoriteUserIds = ViewBag.FavoriteUserIds as HashSet<int> ?? new HashSet<int>();
}

<div class="chat-list-panel chat-list-view">
    <div class="chat-list-header">
        <a href="@Url.Action("Index", "Home")" class="brand-container" style="text-decoration: none; color: inherit;" title="Chats">
            <h1 class="brand-title">Chats</h1>
        </a>
        <div class="header-actions">
            <button class="icon-btn" id="searchToggleBtn" title="Search">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
            </button>
            <a href="@Url.Action("Profile", "Home")" class="icon-btn" title="Settings">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="1" />
                    <circle cx="19" cy="12" r="1" />
                    <circle cx="5" cy="12" r="1" />
                </svg>
            </a>
        </div>
    </div>

    <div class="search-bar-container" id="searchBarContainer" style="display:none; padding: 10px 16px;">
        <input type="text" id="contactSearchInput" placeholder="Search contacts... (⌘K)" style="width:100%; padding:8px 14px; border-radius:8px; border:1px solid #3c3e44; background:#1e1f22; color:#fff; font-size:14px; outline:none;" />
    </div>

    <div class="updates-section">
        <a href="@Url.Action("Updates", "Home")" class="updates-header" style="text-decoration: none; color: inherit;" title="View Updates">
            <div class="updates-header-icon" style="color: #EE4C49; display: flex; align-items: center;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <path d="M12 8v8M8 12h8" />
                </svg>
            </div>
            <h2 class="section-title">Updates</h2>
        </a>
        <div class="updates-carousel">
            <a href="@Url.Action("AddStatus", "Home")" class="update-item" id="addStatusBtn" style="text-decoration: none; color: inherit; cursor: pointer;" title="Add Status">
                <div class="add-avatar">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19" />
                        <line x1="5" y1="12" x2="19" y2="12" />
                    </svg>
                </div>
                <span class="update-name">Add</span>
            </a>
            @if (statuses != null && statuses.Any())
            {
                foreach (var status in statuses)
                {
                    <div class="update-item status-item" data-media="@status.MediaUrl" data-user="@status.Username" data-caption="@(status.Caption ?? "")" data-time="@status.CreatedAt.ToString("HH:mm")" style="cursor: pointer;" title="@status.Username">
                        <img src="@status.MediaUrl" alt="@status.Username" class="avatar-image update-carousel-avatar" style="border: 2px solid #ee4c49;" onerror="this.src='/images/logo.png';" />
                        <span class="update-name">@status.Username</span>
                    </div>
                }
            }
        </div>
    </div>

    <div class="filter-tabs">
        <button class="filter-pill active" data-filter="chats">
            Chats
            @if (Model != null && Model.Count > 0)
            {
                <span class="badge">@Model.Count</span>
            }
        </button>
        <button class="filter-pill" data-filter="groups" id="filterGroupsBtn">Groups <span class="badge" id="groupsBadge">3</span></button>
        <button class="filter-pill" data-filter="unread">Unread</button>
        <button class="filter-pill" data-filter="favorites" id="favFilterBtn">
            Favorites
            @if (favoriteUserIds.Count > 0)
            {
                <span class="badge" id="favBadge">@favoriteUserIds.Count</span>
            }
            else
            {
                <span class="badge" id="favBadge" style="display: none;">0</span>
            }
        </button>
    </div>

    <div class="chat-list" id="chatList">
        @if (Model != null && Model.Any())
        {
            @foreach (var user in Model)
            {
                <a href="@Url.Action("Index", "Chat", new { userId = user.Id })" class="chat-item" data-username="@user.Username.ToLower()" data-user-id="@user.Id" data-favorite="@(favoriteUserIds.Contains(user.Id) ? "true" : "false")">
                    <div class="chat-avatar-wrapper">
                        @if (!string.IsNullOrWhiteSpace(user.Avatar) && user.Avatar != "user.png")
                        {
                            <img src="@user.AvatarPath" alt="@user.Username" class="avatar-image chat-avatar" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                            <div class="avatar-circle chat-avatar-fallback" style="display: none;">@user.Initial</div>
                        }
                        else
                        {
                            <div class="avatar-circle chat-avatar-fallback">@user.Initial</div>
                        }
                    </div>
                    <div class="chat-info">
                        <div class="chat-info-top">
                            <h3>@user.Username</h3>
                            <span class="chat-time">
                                @if (lastMessageTimes != null && lastMessageTimes.ContainsKey(user.Id))
                                {
                                    @lastMessageTimes[user.Id]
                                }
                            </span>
                        </div>
                        <div class="chat-info-bottom">
                            <p class="last-message-preview">
                                @if (lastMessages != null && lastMessages.ContainsKey(user.Id))
                                {
                                    var previewText = lastMessages[user.Id];
                                    if (previewText != null && previewText.Contains("[img]"))
                                    {
                                        @:📷 Photo
                                    }
                                    else
                                    {
                                        @previewText
                                    }
                                }
                                else
                                {
                                    @:No messages yet
                                }
                            </p>
                            @if (unreadCounts != null && unreadCounts.ContainsKey(user.Id) && unreadCounts[user.Id] > 0)
                            {
                                <span class="unread-count-badge">@unreadCounts[user.Id]</span>
                            }
                        </div>
                    </div>
                </a>
            }
        }
        else
        {
            <div class="empty-state" style="padding: 40px 16px; text-align: center; color: #888;">
                <p>No contacts found.</p>
            </div>
        }
        <div id="noResultsState" class="empty-state" style="display:none; padding: 40px 16px; text-align: center; color: #888;">
            <p>No matching conversations found.</p>
        </div>
    </div>

    <!-- Dedicated Group Chats List -->
    <div class="group-list-container" id="groupListContainer" style="display: none;">
        <div class="group-list-header">
            <span>Groups</span>
            <button type="button" class="btn-new-group" id="btnOpenNewGroupModal">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                + New Group
            </button>
        </div>
        <div id="groupList"></div>
    </div>
</div>

<div class="conversation-panel" id="conversationPanel">
    <div class="empty-conversation" id="emptyWorkspaceSection">
        <div class="empty-state">
            <div class="empty-state-icon-wrapper">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                </svg>
            </div>
            <h2 class="empty-state-title">Your Messages</h2>
            <p class="empty-state-description">Select a conversation or start a new message to begin chatting.</p>
            <button type="button" class="btn-start-conversation" id="startNewConversationBtn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>Start New Conversation</span>
            </button>
            <div class="empty-state-hint">
                <span>Press <kbd>⌘K</kbd> or <kbd>Ctrl+K</kbd> to search</span>
            </div>
        </div>
    </div>

    <!-- Active Group Conversation View -->
    <div id="groupWorkspaceSection" class="chat-conversation-view" style="display: none; height: 100%; flex-direction: column;">
        <div class="conversation-header">
            <div class="conversation-user">
                <div class="group-avatar" id="groupHeaderAvatar" style="width: 40px; height: 40px; border-radius: 12px; margin-right: 12px;">DT</div>
                <div class="conversation-user-info">
                    <h3 id="groupHeaderTitle">Design Team</h3>
                    <span class="typing-status" id="groupHeaderStatus">6 members</span>
                </div>
            </div>
            <div class="conversation-actions">
                <button type="button" class="icon-btn" title="Group Call">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                    </svg>
                </button>
                <a href="@Url.Action("Profile", "Home")" class="icon-btn" title="Group Settings">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="1" />
                        <circle cx="19" cy="12" r="1" />
                        <circle cx="5" cy="12" r="1" />
                    </svg>
                </a>
            </div>
        </div>

        <div class="messages-container" id="groupMessagesContainer" style="flex: 1; overflow-y: auto; padding: 20px;"></div>

        <form id="groupMessageForm" class="message-input-form" style="position: relative;">
            <input type="text" id="groupMessageInput" placeholder="Type a message..." required autocomplete="off" />
            <button type="submit" class="send-btn" title="Send">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="22" y1="2" x2="11" y2="13" />
                    <polygon points="22 2 15 22 11 13 2 9 22 2" />
                </svg>
            </button>
        </form>
    </div>
</div>

<!-- Create Group Modal -->
<div id="createGroupModal" class="group-modal-overlay" style="display: none;">
    <div class="group-modal-card">
        <div class="group-modal-header">
            <h3>Create New Group</h3>
            <button type="button" class="group-modal-close" id="closeCreateGroupBtn">&times;</button>
        </div>
        <form id="createGroupForm">
            <div class="group-modal-body">
                <div class="group-form-group">
                    <label for="newGroupNameInput">Group Name</label>
                    <input type="text" id="newGroupNameInput" class="group-form-input" placeholder="e.g. Design Team" required autocomplete="off" />
                </div>
                <div class="group-form-group">
                    <label>Add Members</label>
                    <div class="contacts-checklist-wrap" id="contactsChecklist">
                        <!-- Populated by JS -->
                    </div>
                </div>
            </div>
            <div class="group-modal-footer">
                <button type="button" class="btn-modal-cancel" id="cancelCreateGroupBtn">Cancel</button>
                <button type="submit" class="btn-modal-create" id="submitCreateGroupBtn">Create Group</button>
            </div>
        </form>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
    const currentUserId = @(currentUserId ?? 0);

    // Search toggle & input
    const searchBtn = document.getElementById('searchToggleBtn');
    const searchContainer = document.getElementById('searchBarContainer');
    const searchInput = document.getElementById('contactSearchInput');

    function openSearch() {
        if (searchContainer && searchInput) {
            searchContainer.style.display = 'block';
            searchInput.focus();
            searchInput.select();
        }
    }

    if (searchBtn && searchContainer && searchInput) {
        searchBtn.addEventListener('click', () => {
            const isHidden = searchContainer.style.display === 'none';
            searchContainer.style.display = isHidden ? 'block' : 'none';
            if (isHidden) {
                searchInput.focus();
            } else {
                searchInput.value = '';
                applyFilters();
            }
        });

        searchInput.addEventListener('input', () => {
            applyFilters();
        });

        document.addEventListener('keydown', (e) => {
            if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) {
                e.preventDefault();
                openSearch();
            }
        });
    }

    const startNewBtn = document.getElementById('startNewConversationBtn');
    if (startNewBtn) {
        startNewBtn.addEventListener('click', openSearch);
    }

    // ============================================================
    // Group Chats Implementation (Client-side Prototype)
    // ============================================================
    const sampleGroups = [
        {
            id: 'group-1',
            name: 'Design Team',
            members: ['You', 'Alice', 'francis', 'joana', 'caleb_qa_5136', 'arnold_new'],
            avatarGradient: 'linear-gradient(135deg, #ec4899, #8b5cf6)',
            initials: 'DT',
            lastMessage: 'Alice: The new mockups and dark theme specs are ready for review!',
            lastTime: '14:25',
            messages: [
                { sender: 'Alice', content: 'Hey team, please review the latest sprint designs.', time: '14:10', isSelf: false },
                { sender: 'francis', content: 'Looks super clean! Love the new coral accent.', time: '14:18', isSelf: false },
                { sender: 'You', content: 'Checking it out right now, great work everyone.', time: '14:22', isSelf: true },
                { sender: 'Alice', content: 'The new mockups and dark theme specs are ready for review!', time: '14:25', isSelf: false }
            ]
        },
        {
            id: 'group-2',
            name: 'Product Launch Sprint',
            members: ['You', 'David', 'Sarah', 'arnold_new', 'armanullah'],
            avatarGradient: 'linear-gradient(135deg, #06b6d4, #3b82f6)',
            initials: 'PL',
            lastMessage: 'David: All QA checklists cleared for deployment.',
            lastTime: '13:05',
            messages: [
                { sender: 'David', content: 'Staging environment is updated with the latest build.', time: '12:45', isSelf: false },
                { sender: 'Sarah', content: 'Testing authentication persistence across reloads.', time: '12:58', isSelf: false },
                { sender: 'David', content: 'All QA checklists cleared for deployment.', time: '13:05', isSelf: false }
            ]
        },
        {
            id: 'group-3',
            name: 'Weekend Gamers',
            members: ['You', 'Sam', 'joana', 'benedict', 'francis'],
            avatarGradient: 'linear-gradient(135deg, #f59e0b, #ef4444)',
            initials: 'WG',
            lastMessage: 'Sam: Anyone up for a raid this Saturday night?',
            lastTime: 'Yesterday',
            messages: [
                { sender: 'Sam', content: 'Who is free this weekend for some matches?', time: 'Yesterday', isSelf: false },
                { sender: 'joana', content: 'Count me in for Saturday evening!', time: 'Yesterday', isSelf: false },
                { sender: 'Sam', content: 'Anyone up for a raid this Saturday night?', time: 'Yesterday', isSelf: false }
            ]
        }
    ];

    let activeGroupChatId = null;

    window.addEventListener('DOMContentLoaded', () => {
        renderGroupsList();
    });

    function escapeHtml(text) {
        if (!text) return '';
        const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return text.toString().replace(/[&<>"']/g, m => map[m]);
    }

    function renderGroupsList() {
        const list = document.getElementById('groupList');
        if (!list) return;
        list.innerHTML = '';

        const badge = document.getElementById('groupsBadge');
        if (badge) {
            badge.textContent = sampleGroups.length;
            badge.style.display = sampleGroups.length > 0 ? 'inline-flex' : 'none';
        }

        sampleGroups.forEach(group => {
            const item = document.createElement('div');
            item.className = `group-item ${activeGroupChatId === group.id ? 'active' : ''}`;
            item.setAttribute('data-group-id', group.id);
            item.innerHTML = `
                <div class="group-avatar" style="background: ${group.avatarGradient};">
                    ${escapeHtml(group.initials)}
                </div>
                <div class="group-info">
                    <div class="group-info-top">
                        <h3>${escapeHtml(group.name)} <span class="group-member-count">(${group.members.length})</span></h3>
                        <span class="group-time">${escapeHtml(group.lastTime)}</span>
                    </div>
                    <div class="chat-info-bottom">
                        <p class="last-message-preview">${escapeHtml(group.lastMessage)}</p>
                    </div>
                </div>
            `;
            item.addEventListener('click', () => {
                selectGroup(group.id);
            });
            list.appendChild(item);
        });
    }

    function selectGroup(groupId) {
        activeGroupChatId = groupId;
        const group = sampleGroups.find(g => g.id === groupId);
        if (!group) return;

        // Highlight in list
        document.querySelectorAll('.group-item').forEach(el => {
            el.classList.toggle('active', el.getAttribute('data-group-id') === groupId);
        });

        // Switch to group workspace
        const emptySec = document.getElementById('emptyWorkspaceSection');
        const groupSec = document.getElementById('groupWorkspaceSection');
        if (emptySec) emptySec.style.display = 'none';
        if (groupSec) groupSec.style.display = 'flex';

        // Header update
        const avatar = document.getElementById('groupHeaderAvatar');
        const title = document.getElementById('groupHeaderTitle');
        const status = document.getElementById('groupHeaderStatus');

        if (avatar) {
            avatar.style.background = group.avatarGradient;
            avatar.textContent = group.initials;
        }
        if (title) title.textContent = group.name;
        if (status) status.textContent = `${group.members.length} members • ${group.members.slice(0, 3).join(', ')}${group.members.length > 3 ? '...' : ''}`;

        renderGroupMessages(group);
    }

    function renderGroupMessages(group) {
        const container = document.getElementById('groupMessagesContainer');
        if (!container) return;
        container.innerHTML = '';

        if (!group.messages || group.messages.length === 0) {
            container.innerHTML = `<div class="empty-conversation-notice" style="text-align: center; margin: auto; color: #888;"><p>No messages in ${escapeHtml(group.name)} yet. Say hello to everyone!</p></div>`;
            return;
        }

        group.messages.forEach(msg => {
            const div = document.createElement('div');
            div.className = `message ${msg.isSelf ? 'sent' : 'received'}`;
            div.innerHTML = `
                <div class="message-bubble">
                    ${!msg.isSelf ? `<span class="message-sender-name">${escapeHtml(msg.sender)}</span>` : ''}
                    <p>${escapeHtml(msg.content)}</p>
                    <div class="message-meta">
                        <span class="timestamp">${escapeHtml(msg.time)}</span>
                    </div>
                </div>
            `;
            container.appendChild(div);
        });
        container.scrollTop = container.scrollHeight;
    }

    function sendGroupMessage(groupId, text) {
        const group = sampleGroups.find(g => g.id === groupId);
        if (!group) return;

        const now = new Date();
        const timeStr = now.getHours().toString().padStart(2, '0') + ':' + now.getMinutes().toString().padStart(2, '0');
        group.messages.push({
            sender: 'You',
            content: text,
            time: timeStr,
            isSelf: true
        });
        group.lastMessage = `You: ${text}`;
        group.lastTime = timeStr;

        renderGroupMessages(group);
        renderGroupsList();
    }

    function switchToGroupsView() {
        const railChats = document.getElementById('railChatsBtn');
        const railGroups = document.getElementById('railGroupsBtn');
        if (railChats) railChats.classList.remove('active');
        if (railGroups) railGroups.classList.add('active');

        document.querySelectorAll('.filter-pill').forEach(p => {
            p.classList.toggle('active', p.getAttribute('data-filter') === 'groups');
        });

        const chatList = document.getElementById('chatList');
        const groupListContainer = document.getElementById('groupListContainer');
        const updatesSection = document.querySelector('.updates-section');
        if (chatList) chatList.style.display = 'none';
        if (updatesSection) updatesSection.style.display = 'none';
        if (groupListContainer) groupListContainer.style.display = 'flex';

        renderGroupsList();
        if (!activeGroupChatId && sampleGroups.length > 0) {
            selectGroup(sampleGroups[0].id);
        } else if (activeGroupChatId) {
            selectGroup(activeGroupChatId);
        }
    }

    function switchToChatsView() {
        const railChats = document.getElementById('railChatsBtn');
        const railGroups = document.getElementById('railGroupsBtn');
        if (railChats) railChats.classList.add('active');
        if (railGroups) railGroups.classList.remove('active');

        document.querySelectorAll('.filter-pill').forEach(p => {
            p.classList.toggle('active', p.getAttribute('data-filter') === 'chats');
        });

        const chatList = document.getElementById('chatList');
        const groupListContainer = document.getElementById('groupListContainer');
        const updatesSection = document.querySelector('.updates-section');
        if (chatList) chatList.style.display = 'block';
        if (updatesSection) updatesSection.style.display = 'flex';
        if (groupListContainer) groupListContainer.style.display = 'none';

        const emptySec = document.getElementById('emptyWorkspaceSection');
        const groupSec = document.getElementById('groupWorkspaceSection');
        if (emptySec) emptySec.style.display = 'flex';
        if (groupSec) groupSec.style.display = 'none';

        activeGroupChatId = null;
        applyFilters();
    }

    // Modal logic
    const createGroupModal = document.getElementById('createGroupModal');
    const btnOpenNewGroupModal = document.getElementById('btnOpenNewGroupModal');
    const closeCreateGroupBtn = document.getElementById('closeCreateGroupBtn');
    const cancelCreateGroupBtn = document.getElementById('cancelCreateGroupBtn');
    const createGroupForm = document.getElementById('createGroupForm');
    const newGroupNameInput = document.getElementById('newGroupNameInput');
    const contactsChecklist = document.getElementById('contactsChecklist');

    function openCreateGroupModal() {
        if (!createGroupModal) return;
        if (contactsChecklist) {
            contactsChecklist.innerHTML = '';
            const contactItems = document.querySelectorAll('.chat-item');
            const addedNames = new Set();
            contactItems.forEach(item => {
                const nameEl = item.querySelector('h3');
                const name = nameEl ? nameEl.textContent.trim() : null;
                if (name && !addedNames.has(name)) {
                    addedNames.add(name);
                    const label = document.createElement('label');
                    label.className = 'contact-check-item';
                    label.innerHTML = `
                        <input type="checkbox" value="${escapeHtml(name)}" checked />
                        <span>${escapeHtml(name)}</span>
                    `;
                    contactsChecklist.appendChild(label);
                }
            });
        }
        if (newGroupNameInput) newGroupNameInput.value = '';
        createGroupModal.style.display = 'flex';
        if (newGroupNameInput) newGroupNameInput.focus();
    }

    function closeCreateGroupModal() {
        if (createGroupModal) createGroupModal.style.display = 'none';
    }

    if (btnOpenNewGroupModal) btnOpenNewGroupModal.addEventListener('click', openCreateGroupModal);
    if (closeCreateGroupBtn) closeCreateGroupBtn.addEventListener('click', closeCreateGroupModal);
    if (cancelCreateGroupBtn) cancelCreateGroupBtn.addEventListener('click', closeCreateGroupModal);
    if (createGroupModal) {
        createGroupModal.addEventListener('click', (e) => {
            if (e.target === createGroupModal) closeCreateGroupModal();
        });
    }

    if (createGroupForm) {
        createGroupForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const name = newGroupNameInput ? newGroupNameInput.value.trim() : '';
            if (!name) return;

            const checkedBoxes = contactsChecklist ? contactsChecklist.querySelectorAll('input:checked') : [];
            const selectedMembers = ['You', ...Array.from(checkedBoxes).map(cb => cb.value)];

            const words = name.split(' ').filter(w => w.length > 0);
            const initials = words.length > 1
                ? (words[0][0] + words[1][0]).toUpperCase()
                : name.substring(0, 2).toUpperCase();

            const palette = [
                'linear-gradient(135deg, #ec4899, #8b5cf6)',
                'linear-gradient(135deg, #06b6d4, #3b82f6)',
                'linear-gradient(135deg, #f59e0b, #ef4444)',
                'linear-gradient(135deg, #6366f1, #a855f7)',
                'linear-gradient(135deg, #10b981, #06b6d4)'
            ];
            const gradient = palette[sampleGroups.length % palette.length];

            const newGroup = {
                id: 'group-' + Date.now(),
                name: name,
                members: selectedMembers,
                avatarGradient: gradient,
                initials: initials,
                lastMessage: 'Group created. Start messaging!',
                lastTime: 'Just now',
                messages: [
                    { sender: 'System', content: `Group "${name}" created with ${selectedMembers.length} members.`, time: 'Just now', isSelf: false }
                ]
            };

            sampleGroups.unshift(newGroup);
            closeCreateGroupModal();
            renderGroupsList();
            selectGroup(newGroup.id);
        });
    }

    // Group Message Form
    const groupMsgForm = document.getElementById('groupMessageForm');
    const groupMsgInput = document.getElementById('groupMessageInput');
    if (groupMsgForm && groupMsgInput) {
        groupMsgForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const text = groupMsgInput.value.trim();
            if (!text || !activeGroupChatId) return;
            sendGroupMessage(activeGroupChatId, text);
            groupMsgInput.value = '';
            groupMsgInput.focus();
        });
    }

    // Rail Navigation click handlers
    const railChats = document.getElementById('railChatsBtn');
    const railGroups = document.getElementById('railGroupsBtn');

    if (railChats) {
        railChats.addEventListener('click', (e) => {
            e.preventDefault();
            switchToChatsView();
        });
    }

    if (railGroups) {
        railGroups.addEventListener('click', (e) => {
            e.preventDefault();
            switchToGroupsView();
        });
    }

    // Filter pills
    let currentFilter = 'chats';
    const filterPills = document.querySelectorAll('.filter-pill');
    filterPills.forEach(pill => {
        pill.addEventListener('click', function () {
            const filter = this.getAttribute('data-filter') || 'chats';
            if (filter === 'groups') {
                switchToGroupsView();
            } else {
                if (activeGroupChatId) {
                    switchToChatsView();
                }
                filterPills.forEach(p => p.classList.remove('active'));
                this.classList.add('active');
                currentFilter = filter;
                applyFilters();
            }
        });
    });

    function applyFilters() {
        const query = (searchInput ? searchInput.value.trim().toLowerCase() : '');
        const items = document.querySelectorAll('.chat-item');
        let visibleCount = 0;

        items.forEach(item => {
            const username = item.getAttribute('data-username') || '';
            const unreadBadge = item.querySelector('.unread-count-badge');
            const hasUnread = unreadBadge && parseInt(unreadBadge.textContent) > 0;

            let matchesFilter = true;
            if (currentFilter === 'unread') {
                matchesFilter = hasUnread;
            } else if (currentFilter === 'favorites') {
                matchesFilter = (item.getAttribute('data-favorite') === 'true');
            } else if (currentFilter === 'groups') {
                matchesFilter = false;
            }

            const matchesSearch = !query || username.includes(query);

            if (matchesFilter && matchesSearch) {
                item.style.display = 'flex';
                visibleCount++;
            } else {
                item.style.display = 'none';
            }
        });

        const noResults = document.getElementById('noResultsState');
        if (noResults) {
            noResults.style.display = (visibleCount === 0) ? 'block' : 'none';
            const p = noResults.querySelector('p');
            if (p) {
                p.textContent = (currentFilter === 'favorites') ? 'No favorite contacts yet.' : 'No matching conversations found.';
            }
        }
    }

    // SignalR real-time updates for chat list
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/chatHub")
        .build();

    connection.on("IncomingCall", (callerId, targetUserId, callerName) => {
        if (targetUserId === currentUserId) {
            if (confirm("Incoming voice call from " + callerName + ". Open conversation to answer?")) {
                window.location.href = '/Chat?userId=' + callerId;
            } else {
                connection.invoke("AnswerCall", currentUserId, callerId, false);
            }
        }
    });

    connection.on("ReceiveMessage", (senderId, receiverId, message, senderName, timestamp) => {
        if (senderId === currentUserId || receiverId === currentUserId) {
            const targetUserId = (senderId === currentUserId) ? receiverId : senderId;
            const chatItems = document.querySelectorAll('.chat-item');
            chatItems.forEach(item => {
                if (item.getAttribute('href').includes('userId=' + targetUserId)) {
                    const preview = item.querySelector('.last-message-preview');
                    const time = item.querySelector('.chat-time');
                    if (preview) preview.textContent = message.includes('[img]') ? '📷 Photo' : message;
                    if (time) time.textContent = timestamp;

                    if (receiverId === currentUserId) {
                        let badge = item.querySelector('.unread-count-badge');
                        if (!badge) {
                            badge = document.createElement('span');
                            badge.className = 'unread-count-badge';
                            badge.textContent = '0';
                            const bottom = item.querySelector('.chat-info-bottom');
                            if (bottom) bottom.appendChild(badge);
                        }
                        const count = parseInt(badge.textContent) || 0;
                        badge.textContent = count + 1;
                    }
                }
            });
        }
    });

    connection.start().catch(err => console.error("SignalR error:", err));

    // Status Upload & Viewer Handlers

    const statusFileInput = document.getElementById('statusFileInput');
    const statusUploadModal = document.getElementById('statusUploadModal');
    const uploadPreviewImg = document.getElementById('uploadPreviewImg');
    const uploadPrompt = document.getElementById('statusUploadPrompt');
    const dropZone = document.getElementById('statusDropZone');
    const closeUploadModalBtn = document.getElementById('closeUploadModalBtn');
    const captionInput = document.getElementById('statusCaptionInput');

    window.openStatusUploadDialog = function () {
        if (statusUploadModal) statusUploadModal.style.display = 'flex';
        if (statusFileInput) {
            try {
                statusFileInput.click();
            } catch (err) {
                console.warn("statusFileInput click error:", err);
            }
        }
    };

    function openStatusModalWithFile(file) {
        if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
                uploadPreviewImg.src = e.target.result;
                uploadPreviewImg.style.display = 'block';
                if (uploadPrompt) uploadPrompt.style.display = 'none';
                if (statusUploadModal) statusUploadModal.style.display = 'flex';
                if (captionInput) captionInput.focus();
            };
            reader.readAsDataURL(file);
        }
    }



    if (dropZone) {
        dropZone.addEventListener('click', () => {
            if (statusFileInput) statusFileInput.click();
        });

        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.style.borderColor = '#ee4c49';
        });

        dropZone.addEventListener('dragleave', () => {
            dropZone.style.borderColor = '';
        });

        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.style.borderColor = '';
            if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) {
                const file = e.dataTransfer.files[0];
                const dt = new DataTransfer();
                dt.items.add(file);
                if (statusFileInput) statusFileInput.files = dt.files;
                openStatusModalWithFile(file);
            }
        });
    }

    if (statusFileInput) {
        statusFileInput.addEventListener('change', function () {
            if (this.files && this.files[0]) {
                openStatusModalWithFile(this.files[0]);
            }
        });
    }

    if (closeUploadModalBtn && statusUploadModal) {
        closeUploadModalBtn.addEventListener('click', () => {
            statusUploadModal.style.display = 'none';
            statusFileInput.value = '';
            uploadPreviewImg.src = '';
            uploadPreviewImg.style.display = 'none';
            if (uploadPrompt) uploadPrompt.style.display = 'flex';
        });

        statusUploadModal.addEventListener('click', (e) => {
            if (e.target === statusUploadModal) {
                statusUploadModal.style.display = 'none';
                statusFileInput.value = '';
                uploadPreviewImg.src = '';
                uploadPreviewImg.style.display = 'none';
                if (uploadPrompt) uploadPrompt.style.display = 'flex';
            }
        });
    }

    // Status Viewer
    const statusViewerModal = document.getElementById('statusViewerModal');
    const viewerImage = document.getElementById('viewerImage');
    const viewerUsername = document.getElementById('viewerUsername');
    const viewerTime = document.getElementById('viewerTime');
    const viewerCaption = document.getElementById('viewerCaption');
    const closeViewerModalBtn = document.getElementById('closeViewerModalBtn');

    document.querySelectorAll('.status-item').forEach(item => {
        item.addEventListener('click', function () {
            const media = this.getAttribute('data-media');
            const user = this.getAttribute('data-user');
            const caption = this.getAttribute('data-caption');
            const time = this.getAttribute('data-time');

            if (viewerImage) viewerImage.src = media;
            if (viewerUsername) viewerUsername.textContent = user;
            if (viewerTime) viewerTime.textContent = time;

            if (viewerCaption) {
                if (caption && caption.trim().length > 0) {
                    viewerCaption.textContent = caption;
                    viewerCaption.style.display = 'block';
                } else {
                    viewerCaption.style.display = 'none';
                }
            }

            if (statusViewerModal) statusViewerModal.style.display = 'flex';
        });
    });

    if (closeViewerModalBtn && statusViewerModal) {
        closeViewerModalBtn.addEventListener('click', () => {
            statusViewerModal.style.display = 'none';
        });

        statusViewerModal.addEventListener('click', (e) => {
            if (e.target === statusViewerModal) {
                statusViewerModal.style.display = 'none';
            }
        });
    }
</script>

<!-- Status Upload Modal -->
<div id="statusUploadModal" class="status-modal" style="display: none;">
    <div class="status-modal-content">
        <div class="status-modal-header">
            <h3>New Status</h3>
            <button type="button" id="closeUploadModalBtn" class="status-close-btn">&times;</button>
        </div>
        <form method="post" asp-action="CreateStatus" asp-controller="Home" enctype="multipart/form-data" id="statusUploadForm">
            <div class="status-preview-box" id="statusDropZone" style="cursor: pointer;" title="Click to choose photo">
                <img id="uploadPreviewImg" src="" alt="Preview" style="display: none;" />
                <div id="statusUploadPrompt" style="display: flex; flex-direction: column; align-items: center; gap: 8px; color: #888;">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                        <circle cx="8.5" cy="8.5" r="1.5" />
                        <polyline points="21 15 16 10 5 21" />
                    </svg>
                    <span style="font-size: 13px;">Click to select photo</span>
                </div>
            </div>
            <input type="file" id="statusFileInput" name="statusImage" accept="image/*" required style="display: none;" />
            <div class="status-caption-row">
                <input type="text" name="caption" id="statusCaptionInput" placeholder="Add a caption..." autocomplete="off" />
                <button type="submit" class="primary-button" style="width: auto; padding: 0 20px; height: 40px;">Send</button>
            </div>
        </form>
    </div>
</div>

<!-- Status Viewer Modal -->
<div id="statusViewerModal" class="status-modal" style="display: none;">
    <div class="status-modal-content viewer">
        <div class="status-modal-header">
            <div class="status-user-info">
                <strong id="viewerUsername" style="color: #fff; font-size: 15px;"></strong>
                <span id="viewerTime" style="font-size: 12px; color: #888; margin-left: 8px;"></span>
            </div>
            <button type="button" id="closeViewerModalBtn" class="status-close-btn">&times;</button>
        </div>
        <div class="status-viewer-media">
            <img id="viewerImage" src="" alt="Status" />
        </div>
        <p id="viewerCaption" class="status-viewer-caption" style="display: none;"></p>
    </div>
</div>