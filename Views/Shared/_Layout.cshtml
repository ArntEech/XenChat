<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - XenChat</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (Context.Session.GetInt32("UserId") != null)
    {
        <div class="app-container">
            <nav class="sidebar">
                <div class="sidebar-logo">
                    <img src="~/images/logo.png" alt="XenChat Logo" class="sidebar-logo-image" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                    <div class="sidebar-logo-fallback" style="display: none;">X</div>
                </div>
                <div class="sidebar-nav">
                    <a href="@Url.Action("Index", "Home")" class="nav-icon @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" title="Chats">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                        </svg>
                    </a>
                    <a href="@Url.Action("Camera", "Home")" class="nav-icon @(ViewContext.RouteData.Values["action"]?.ToString() == "Camera" ? "active" : "")" title="Camera">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
                            <circle cx="12" cy="13" r="4" />
                        </svg>
                    </a>
                    <a href="@Url.Action("Updates", "Home")" class="nav-icon @(ViewContext.RouteData.Values["action"]?.ToString() == "Updates" ? "active" : "")" title="Updates">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10" />
                            <path d="M12 8v8M8 12h8" />
                        </svg>
                    </a>
                    <a href="@Url.Action("Profile", "Home")" class="nav-icon @(ViewContext.RouteData.Values["action"]?.ToString() == "Profile" ? "active" : "")" title="Profile">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                    </a>
                </div>
                <div class="sidebar-bottom">
                    <a href="@Url.Action("Profile", "Home")" class="user-avatar-small" title="Profile">
                        <div class="avatar-circle small">@(string.IsNullOrEmpty(Context.Session.GetString("Username")) ? "?" : Context.Session.GetString("Username")!.Substring(0, 1).ToUpper())</div>
                    </a>
                    <a href="@Url.Action("Logout", "Account")" class="nav-icon logout-icon" title="Logout">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                            <polyline points="16 17 21 12 16 7" />
                            <line x1="21" y1="12" x2="9" y2="12" />
                        </svg>
                    </a>
                </div>
            </nav>
            <main class="main-content">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main>
            @RenderBody()
        </main>
    }
    <script src="~/js/site.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>