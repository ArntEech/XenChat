@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — XenChat</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Manrope:wght@400;500&family=Montserrat:wght@600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <main class="auth-shell">
        <aside class="auth-art" aria-hidden="true">
            <img src="~/images/sn_bg.png" alt="" />
        </aside>

        <section class="auth-main">
            <form class="auth-form" method="post" asp-action="Login" asp-controller="Account" autocomplete="off">

                <div class="brand">
                    <img src="~/images/logo.png" alt="XenChat" onerror="this.style.display='none';" />
                    <span>XenChat</span>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="auth-error">@ViewBag.Error</div>
                }

                @if (TempData["SignupSuccess"] != null)
                {
                    <div class="auth-success">@TempData["SignupSuccess"]</div>
                }

                <label>
                    <span>Email</span>
                    <input type="email"
                           name="email"
                           required
                           autocomplete="off"
                           placeholder="Enter email" />
                </label>

                <label>
                    <span>password</span>
                    <input type="password"
                           name="password"
                           required
                           minlength="6"
                           autocomplete="new-password"
                           placeholder="Enter password" />
                </label>

                <button class="primary-button" type="submit">LogIn</button>

                <div class="or">
                    <span></span>
                    OR
                    <span></span>
                </div>

                <button class="google-button" type="button" disabled title="Google login is currently unavailable" style="opacity: 0.55; cursor: not-allowed;">
                    <span class="google-icon">
                        <img src="~/images/google.png" alt="" onerror="this.style.display='none';" />
                    </span>
                    Continue with Google (Unavailable)
                </button>

                <p class="auth-switch">
                    Don’t Have an account?
                    <a href="@Url.Action("Signup", "Account")">Sign Up</a>
                </p>
            </form>
        </section>
    </main>

    <script>
        (function () {
            const urlParams = new URLSearchParams(window.location.search);
            const isLogout = urlParams.get('logout') === 'true';
            const returnUrl = urlParams.get('ReturnUrl') || urlParams.get('returnUrl');
            const targetUrl = (returnUrl && returnUrl.startsWith('/') && !returnUrl.startsWith('//'))
                ? returnUrl
                : '@Url.Action("Index", "Home")';

            @if (ViewBag.Token != null)
            {
                <text>
                localStorage.setItem('xenchat_token', '@ViewBag.Token');
                window.location.href = targetUrl;
                return;
                </text>
            }

            if (isLogout) {
                localStorage.removeItem('xenchat_token');
                if (window.history.replaceState) {
                    window.history.replaceState({}, document.title, window.location.pathname);
                }
            } else {
                const token = localStorage.getItem('xenchat_token');
                if (token) {
                    fetch('@Url.Action("RestoreSession", "Account")', {
                        method: 'POST',
                        headers: {
                            'Authorization': 'Bearer ' + token,
                            'Accept': 'application/json'
                        }
                    })
                    .then(res => {
                        if (res.ok) {
                            return res.json().then(data => {
                                if (data && data.success) {
                                    window.location.href = targetUrl;
                                } else {
                                    localStorage.removeItem('xenchat_token');
                                }
                            });
                        } else {
                            localStorage.removeItem('xenchat_token');
                        }
                    })
                    .catch(() => {
                        localStorage.removeItem('xenchat_token');
                    });
                }
            }

            const form = document.querySelector('.auth-form');
            if (form) {
                form.addEventListener('submit', async function (e) {
                    e.preventDefault();

                    const emailInput = form.querySelector('input[name="email"]');
                    const passwordInput = form.querySelector('input[name="password"]');
                    const email = emailInput ? emailInput.value.trim() : '';
                    const password = passwordInput ? passwordInput.value : '';

                    const formData = new FormData();
                    formData.append('email', email);
                    formData.append('password', password);

                    try {
                        const response = await fetch('@Url.Action("Login", "Account")', {
                            method: 'POST',
                            headers: {
                                'Accept': 'application/json'
                            },
                            body: formData
                        });

                        const data = await response.json();
                        if (data && data.success && data.token) {
                            localStorage.setItem('xenchat_token', data.token);
                            window.location.href = targetUrl;
                        } else {
                            let errorDiv = document.querySelector('.auth-error');
                            if (!errorDiv) {
                                errorDiv = document.createElement('div');
                                errorDiv.className = 'auth-error';
                                const brand = document.querySelector('.brand');
                                if (brand) {
                                    brand.insertAdjacentElement('afterend', errorDiv);
                                } else {
                                    form.prepend(errorDiv);
                                }
                            }
                            errorDiv.textContent = data.error || 'Invalid email or password';
                        }
                    } catch (err) {
                        form.submit();
                    }
                });
            }
        })();
    </script>
</body>
</html>