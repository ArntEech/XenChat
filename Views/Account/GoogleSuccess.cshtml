@{
    Layout = null;
    var token = ViewBag.Token as string ?? "";
    var targetUrl = ViewBag.TargetUrl as string ?? "/";
    var username = ViewBag.Username as string ?? "User";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Signing in — XenChat</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: #18181b;
            color: #f4f4f5;
            font-family: 'Poppins', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }
        .loading-card {
            background: #23232a;
            border: 1px solid #33333e;
            border-radius: 16px;
            padding: 40px 32px;
            text-align: center;
            max-width: 380px;
            width: 90%;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }
        .spinner {
            width: 48px;
            height: 48px;
            border: 4px solid #33333e;
            border-top-color: #ee4c49;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin: 0 auto 20px;
        }
        @@keyframes spin {
            to { transform: rotate(360deg); }
        }
        h2 { font-size: 18px; font-weight: 600; margin-bottom: 8px; color: #fff; }
        p { font-size: 14px; color: #a1a1aa; }
    </style>
</head>
<body>
    <div class="loading-card">
        <div class="spinner"></div>
        <h2>Welcome, @username!</h2>
        <p>Completing Google sign-in...</p>
    </div>
    <script>
        try {
            var token = '@token';
            if (token) {
                localStorage.setItem('xenchat_token', token);
            }
        } catch (e) {
            console.error("Could not set local token", e);
        }
        setTimeout(function () {
            window.location.replace('@targetUrl');
        }, 120);
    </script>
</body>
</html>
