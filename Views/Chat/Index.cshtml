            lastTime: '14:25',
            messages: [
                { sender: 'Alice', content: 'Hey team, please review the latest sprint designs.', time: '14:10', isSelf: false },
                { sender: 'Francis', content: 'Looks super clean! Love the high contrast dark mode.', time: '14:18', isSelf: false },
                { sender: 'You', content: 'Checking it out right now, great work everyone.', time: '14:22', isSelf: true },
                { sender: 'Alice', content: 'The dark theme specs are ready for review!', time: '14:25', isSelf: false }
            ]
        },
