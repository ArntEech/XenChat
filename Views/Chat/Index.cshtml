@model List<XenChat.Models.Message>
@{
    ViewData["Title"] = "Chat";
    var currentUserId = ViewBag.CurrentUserId;
    var currentUser = ViewBag.CurrentUser;
    var otherUser = ViewBag.OtherUser;
    var allUsers = ViewData["AllUsers"] as List<XenChat.Models.User>;
    var lastMessages = ViewBag.LastMessages as Dictionary<int, string>;
    var lastMessageTimes = ViewBag.LastMessageTimes as Dictionary<int, string>;
    var unreadCounts = ViewBag.UnreadCounts as Dictionary<int, int>;
    var isFavorite = (ViewBag.IsFavorite as bool?) ?? false;
    var favoriteUserIds = ViewBag.FavoriteUserIds as HashSet<int> ?? new HashSet<int>();
}

<div class="chat-list-panel chat-conversation-view">
    <div class="chat-list-header">
        <a href="@Url.Action("Index", "Home")" class="brand-container" style="text-decoration: none; color: inherit;" title="XenChat">
            <img src="~/images/logo.png" alt="XenChat Logo" class="brand-logo" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
            <div class="brand-logo-fallback" style="display: none;">X</div>
            <h1 class="brand-title">XenChat</h1>
        </a>
        <div class="header-actions">
            <button class="icon-btn" id="searchToggleBtn" title="Search">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
            </button>
            <a href="@Url.Action("Profile", "Home")" class="icon-btn" title="Settings">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="1" />
                    <circle cx="19" cy="12" r="1" />
                    <circle cx="5" cy="12" r="1" />
                </svg>
            </a>
        </div>
    </div>

    <div class="search-bar-container" id="searchBarContainer" style="display:none; padding: 10px 16px;">
        <input type="text" id="contactSearchInput" placeholder="Search contacts..." style="width:100%; padding:8px 14px; border-radius:8px; border:1px solid #3c3e44; background:#1e1f22; color:#fff; font-size:14px; outline:none;" />
    </div>

    <div class="updates-section">
        <a href="@Url.Action("Updates", "Home")" class="updates-header" style="text-decoration: none; color: inherit;" title="View Updates">
            <img src="~/images/logo.png" alt="Updates" class="updates-logo" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
            <div class="updates-logo-fallback" style="display: none;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <path d="M12 8v8M8 12h8" />
                </svg>
            </div>
            <h2 class="section-title">Updates</h2>
        </a>
        <div class="updates-carousel">
            <a href="@Url.Action("AddStatus", "Home")" class="update-item" style="text-decoration:none; color:inherit;" title="Add Status">
                <div class="add-avatar">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19" />
                        <line x1="5" y1="12" x2="19" y2="12" />
                    </svg>
                </div>
                <span class="update-name">Add</span>
            </a>
            @if (allUsers != null)
            {
                foreach (var user in allUsers.Take(6))
                {
                    <a href="@Url.Action("Index", "Chat", new { userId = user.Id })" class="update-item" style="text-decoration:none; color:inherit;">
                        <img src="@user.AvatarPath" alt="@user.Username" class="avatar-image update-carousel-avatar" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <div class="avatar-circle update-carousel-avatar" style="display: none;">@user.Initial</div>
                        <span class="update-name">@user.Username</span>
                    </a>
                }
            }
        </div>
    </div>

    <div class="filter-tabs">
        <button class="filter-pill active" data-filter="chats">
            Chats
            @if (allUsers != null)
            {
                <span class="badge">@allUsers.Count</span>
            }
        </button>
        <button class="filter-pill" data-filter="groups" disabled title="Groups (Unavailable)" style="opacity: 0.45; cursor: not-allowed;">Groups</button>
        <button class="filter-pill" data-filter="unread">Unread</button>
        <button class="filter-pill" data-filter="favorites" id="favFilterBtn">Favorites <span class="badge" id="favBadge">@favoriteUserIds.Count</span></button>
    </div>

    <div class="chat-list" id="chatList">
        @if (allUsers != null && allUsers.Any())
        {
            foreach (var user in allUsers)
            {
                <a href="@Url.Action("Index", "Chat", new { userId = user.Id })"
                       class="chat-item @(user.Id == otherUser.Id ? "active" : "")"
                       data-username="@user.Username.ToLower()"
                       data-user-id="@user.Id"
                       data-favorite="@(favoriteUserIds.Contains(user.Id) ? "true" : "false")">
                    <img src="@user.AvatarPath" alt="@user.Username" class="avatar-image chat-avatar" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                    <div class="avatar-circle chat-avatar-fallback" style="display: none;">@user.Initial</div>
                    <div class="chat-info">
                        <div class="chat-info-top">
                            <h3>@user.Username</h3>
                            <span class="chat-time">
                                @if (lastMessageTimes != null && lastMessageTimes.ContainsKey(user.Id))
                                {
                                    @lastMessageTimes[user.Id]
                                }
                            </span>
                        </div>
                        <div class="chat-info-bottom">
                            <p class="last-message-preview">
                                @if (lastMessages != null && lastMessages.ContainsKey(user.Id))
                                {
                                    var previewText = lastMessages[user.Id];
                                    if (previewText != null && previewText.Contains("[img]"))
                                    {
                                        @:📷 Photo
                                    }
                                    else
                                    {
                                        @previewText
                                    }
                                }
                                else
                                {
                                    @:No messages yet
                                }
                            </p>
                            @if (unreadCounts != null && unreadCounts.ContainsKey(user.Id) && unreadCounts[user.Id] > 0 && user.Id != otherUser?.Id)
                            {
                                <span class="unread-count-badge">@unreadCounts[user.Id]</span>
                            }
                        </div>
                    </div>
                </a>
            }
        }
        else
        {
            <div class="empty-state" style="padding: 40px 16px; text-align: center; color: #888;">
                <p>No contacts found.</p>
            </div>
        }
        <div id="noResultsState" class="empty-state" style="display:none; padding: 40px 16px; text-align: center; color: #888;">
            <p>No matching conversations found.</p>
        </div>
    </div>
</div>

<div class="conversation-panel chat-conversation-view">
    <div class="conversation-header">
        <div class="conversation-user">
            <a href="@Url.Action("Index", "Home")" class="chat-back-btn" id="chatBackBtn" title="Back to chats">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
            </a>
            <img src="@otherUser.AvatarPath" alt="@otherUser.Username" class="avatar-image avatar-large" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
            <div class="avatar-circle large" style="display: none;">@otherUser.Initial</div>
            <div class="conversation-user-info">
                <h3>@otherUser.Username</h3>
                <span class="typing-status">Online</span>
            </div>
        </div>
        <div class="conversation-actions">
            <button type="button" class="favorite-action-btn @(isFavorite ? "active" : "")" id="toggleFavoriteBtn" title="@(isFavorite ? "Remove from Favorites" : "Add to Favorites")" data-target-id="@otherUser.Id">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="@(isFavorite ? "#ee4c49" : "none")" stroke="@(isFavorite ? "#ee4c49" : "currentColor")" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
                <span id="favBtnText">@(isFavorite ? "Remove from Favorites" : "Add to Favorites")</span>
            </button>
            <button type="button" class="icon-btn" id="startVoiceCallBtn" title="Start Voice Call">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
            </button>
            <button class="icon-btn" title="Video call (Unavailable)" disabled style="opacity: 0.4; cursor: not-allowed;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="23 7 16 12 23 17 23 7" />
                    <rect x="1" y="5" width="15" height="14" rx="2" ry="2" />
                </svg>
            </button>
            <a href="@Url.Action("Profile", "Home")" class="icon-btn" title="Settings &amp; Options">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="1" />
                    <circle cx="19" cy="12" r="1" />
                    <circle cx="5" cy="12" r="1" />
                </svg>
            </a>
        </div>
    </div>

    <div class="messages-container" id="messagesContainer">
        @if (Model == null || !Model.Any())
        {
            <div class="empty-conversation-notice" id="emptyNotice" style="text-align: center; margin: auto; color: #888;">
                <p>No messages yet. Say hello to @otherUser.Username!</p>
            </div>
        }
        @if (Model != null)
        {
            @foreach (var message in Model)
            {
                <div class="message @(message.SenderId == currentUserId ? "sent" : "received")" data-message-id="@message.MessageId">
                    <div class="message-bubble">
                        @if (message.Content.StartsWith("[img]") && message.Content.Contains("[/img]"))
                        {
                            var endIdx = message.Content.IndexOf("[/img]");
                            var imgUrl = message.Content.Substring(5, endIdx - 5);
                            var caption = message.Content.Substring(endIdx + 6);
                            <div class="chat-image-wrap">
                                <a href="@imgUrl" target="_blank" rel="noopener noreferrer">
                                    <img src="@imgUrl" alt="Photo" class="chat-bubble-image" />
                                </a>
                                @if (!string.IsNullOrWhiteSpace(caption))
                                {
                                    <p class="chat-image-caption">@caption</p>
                                }
                            </div>
                        }
                        else
                        {
                            <p>@message.Content</p>
                        }
                        <div class="message-meta">
                            <span class="timestamp">@message.Timestamp.ToString("HH:mm")</span>
                            @if (message.SenderId == currentUserId)
                            {
                                <button type="button" class="delete-msg-btn" title="Delete message" onclick="deleteMessage(@message.MessageId)">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="3 6 5 6 21 6"></polyline>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                    </svg>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <form id="messageForm" class="message-input-form" style="position: relative;">
        <input type="hidden" id="receiverId" value="@otherUser.Id" />
        <button type="button" class="emoji-btn" id="emojiToggleBtn" title="Insert Emoji">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <path d="M8 14s1.5 2 4 2 4-2 4-2" />
                <line x1="9" y1="9" x2="9.01" y2="9" />
                <line x1="15" y1="9" x2="15.01" y2="9" />
            </svg>
        </button>
        <input type="text" id="messageInput" placeholder="Type a message..." required autocomplete="off" />
        <button type="button" class="attach-btn" id="attachImageBtn" title="Send Photo">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                <circle cx="8.5" cy="8.5" r="1.5" />
                <polyline points="21 15 16 10 5 21" />
            </svg>
        </button>
        <input type="file" id="chatImageInput" accept="image/*" style="display: none;" />
        <button type="submit" class="send-btn" title="Send">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13" />
                <polygon points="22 2 15 22 11 13 2 9 22 2" />
            </svg>
        </button>

        <!-- Emoji Picker Popup -->
        <div id="emojiPickerPopup" class="emoji-picker-popup">
            <div class="emoji-picker-header">
                <span style="font-weight: 500; color: #fff;">Smileys &amp; Emojis</span>
                <span id="closeEmojiPickerBtn" style="cursor: pointer; font-size: 18px; line-height: 1;">&times;</span>
            </div>
            <div class="emoji-grid" id="emojiGrid"></div>
        </div>
    </form>
</div>

<!-- Chat Image Send Modal -->
<div id="chatImageModal" class="chat-image-modal" style="display: none;">
    <div class="chat-image-modal-content">
        <div class="status-modal-header">
            <h3>Send Photo</h3>
            <button type="button" id="closeChatImageModalBtn" class="status-close-btn">&times;</button>
        </div>
        <div class="chat-image-preview-area">
            <img id="chatImagePreview" src="" alt="Selected Photo" />
        </div>
        <div class="status-caption-row">
            <input type="text" id="chatImageCaptionInput" placeholder="Add a caption..." autocomplete="off" />
            <button type="button" id="sendChatImageBtn" class="primary-button" style="width: auto; padding: 0 20px; height: 40px;">Send</button>
        </div>
    </div>
</div>

<!-- Remote Audio Element for WebRTC -->
<audio id="remoteAudio" autoplay playsinline></audio>

<!-- Incoming Call Modal -->
<div id="incomingCallModal" class="call-modal-overlay" style="display: none;">
    <div class="call-modal-card">
        <div class="call-avatar" id="incomingCallAvatar">?</div>
        <h3 class="call-user-name" id="incomingCallerName">Caller</h3>
        <p class="call-status-label">Incoming voice call...</p>
        <div class="call-actions-row">
            <button type="button" class="call-btn call-btn-accept" id="btnAcceptCall">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
                Accept
            </button>
            <button type="button" class="call-btn call-btn-decline" id="btnDeclineCall">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
                Decline
            </button>
        </div>
    </div>
</div>

<!-- Active / Outgoing Call Screen Modal -->
<div id="activeCallModal" class="call-modal-overlay" style="display: none;">
    <div class="call-modal-card">
        <div class="call-avatar" id="activeCallAvatar">@otherUser.Initial</div>
        <h3 class="call-user-name" id="activeCallUserName">@otherUser.Username</h3>
        <p class="call-status-label" id="activeCallStatus">Calling...</p>
        <div class="call-actions-row">
            <button type="button" class="call-btn call-btn-mute" id="btnMuteCall">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
                    <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                    <line x1="12" y1="19" x2="12" y2="23"></line>
                    <line x1="8" y1="23" x2="16" y2="23"></line>
                </svg>
                <span id="muteBtnLabel">Mute</span>
            </button>
            <button type="button" class="call-btn call-btn-end" id="btnEndCall">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.68 13.31a16 16 0 0 0 3.41 2.6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7 2 2 0 0 1 1.72 2v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.42 19.42 0 0 1-3.33-2.67m-2.67-3.34a19.79 19.79 0 0 1-3.07-8.63A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91" />
                    <line x1="1" y1="1" x2="23" y2="23"></line>
                </svg>
                End Call
            </button>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
    const currentUserId = @currentUserId;
    const otherUserId = @otherUser.Id;

    // Search toggle & input
    const searchBtn = document.getElementById('searchToggleBtn');
    const searchContainer = document.getElementById('searchBarContainer');
    const searchInput = document.getElementById('contactSearchInput');

    if (searchBtn && searchContainer && searchInput) {
        searchBtn.addEventListener('click', () => {
            const isHidden = searchContainer.style.display === 'none';
            searchContainer.style.display = isHidden ? 'block' : 'none';
            if (isHidden) {
                searchInput.focus();
            } else {
                searchInput.value = '';
                applyFilters();
            }
        });

        searchInput.addEventListener('input', () => {
            applyFilters();
        });
    }

    // Filter pills
    let currentFilter = 'chats';
    const filterPills = document.querySelectorAll('.filter-pill');
    filterPills.forEach(pill => {
        pill.addEventListener('click', function () {
            filterPills.forEach(p => p.classList.remove('active'));
            this.classList.add('active');
            currentFilter = this.getAttribute('data-filter') || 'chats';
            applyFilters();
        });
    });

    function applyFilters() {
        const query = (searchInput ? searchInput.value.trim().toLowerCase() : '');
        const items = document.querySelectorAll('.chat-item');
        let visibleCount = 0;

        items.forEach(item => {
            const username = item.getAttribute('data-username') || '';
            const unreadBadge = item.querySelector('.unread-count-badge');
            const hasUnread = unreadBadge && parseInt(unreadBadge.textContent) > 0;

            let matchesFilter = true;
            if (currentFilter === 'unread') {
                matchesFilter = hasUnread;
            } else if (currentFilter === 'favorites') {
                matchesFilter = (item.getAttribute('data-favorite') === 'true');
            } else if (currentFilter === 'groups') {
                matchesFilter = false;
            }

            const matchesSearch = !query || username.includes(query);

            if (matchesFilter && matchesSearch) {
                item.style.display = 'flex';
                visibleCount++;
            } else {
                item.style.display = 'none';
            }
        });

        const noResults = document.getElementById('noResultsState');
        if (noResults) {
            noResults.style.display = (visibleCount === 0) ? 'block' : 'none';
            const p = noResults.querySelector('p');
            if (p) {
                p.textContent = (currentFilter === 'favorites') ? 'No favorite contacts yet.' : 'No matching conversations found.';
            }
        }
    }

    // SignalR
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/chatHub", { accessTokenFactory: () => localStorage.getItem("xenchat_token") || "" })
        .build();

    connection.on("ReceiveMessage", (senderId, receiverId, message, senderName, timestamp, messageId) => {
        // If message is between the currently open conversation
        if ((senderId === currentUserId && receiverId === otherUserId) ||
            (senderId === otherUserId && receiverId === currentUserId)) {

            const emptyNotice = document.getElementById("emptyNotice");
            if (emptyNotice) emptyNotice.remove();

            const messagesContainer = document.getElementById("messagesContainer");
            const messageDiv = document.createElement("div");
            messageDiv.className = "message " + (senderId === currentUserId ? "sent" : "received");
            if (messageId) {
                messageDiv.setAttribute("data-message-id", messageId);
            }

            const bubble = document.createElement("div");
            bubble.className = "message-bubble";

            if (message.startsWith("[img]") && message.includes("[/img]")) {
                const endIdx = message.indexOf("[/img]");
                const imgUrl = message.substring(5, endIdx);
                const caption = message.substring(endIdx + 6);

                const wrap = document.createElement("div");
                wrap.className = "chat-image-wrap";

                const link = document.createElement("a");
                link.href = imgUrl;
                link.target = "_blank";
                link.rel = "noopener noreferrer";

                const img = document.createElement("img");
                img.src = imgUrl;
                img.alt = "Photo";
                img.className = "chat-bubble-image";
                link.appendChild(img);
                wrap.appendChild(link);

                if (caption && caption.trim().length > 0) {
                    const capP = document.createElement("p");
                    capP.className = "chat-image-caption";
                    capP.textContent = caption;
                    wrap.appendChild(capP);
                }
                bubble.appendChild(wrap);
            } else {
                const p = document.createElement("p");
                p.textContent = message;
                bubble.appendChild(p);
            }

            const meta = document.createElement("div");
            meta.className = "message-meta";

            const span = document.createElement("span");
            span.className = "timestamp";
            span.textContent = timestamp;
            meta.appendChild(span);

            if (senderId === currentUserId && messageId) {
                const delBtn = document.createElement("button");
                delBtn.type = "button";
                delBtn.className = "delete-msg-btn";
                delBtn.title = "Delete message";
                delBtn.innerHTML = `
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                `;
                delBtn.addEventListener("click", () => deleteMessage(messageId));
                meta.appendChild(delBtn);
            }

            bubble.appendChild(meta);
            messageDiv.appendChild(bubble);

            messagesContainer.appendChild(messageDiv);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        // Update the chat list items in the sidebar
        const targetUserId = (senderId === currentUserId) ? receiverId : senderId;
        const chatItems = document.querySelectorAll('.chat-item');
        chatItems.forEach(item => {
            if (item.getAttribute('href').includes('userId=' + targetUserId)) {
                const preview = item.querySelector('.last-message-preview');
                const time = item.querySelector('.chat-time');
                if (preview) preview.textContent = message.includes('[img]') ? '📷 Photo' : message;
                if (time) time.textContent = timestamp;

                if (receiverId === currentUserId && senderId !== otherUserId) {
                    let badge = item.querySelector('.unread-count-badge');
                    if (!badge) {
                        badge = document.createElement('span');
                        badge.className = 'unread-count-badge';
                        badge.textContent = '0';
                        const bottom = item.querySelector('.chat-info-bottom');
                        if (bottom) bottom.appendChild(badge);
                    }
                    const count = parseInt(badge.textContent) || 0;
                    badge.textContent = count + 1;
                }
            }
        });
    });

    connection.on("MessageDeleted", (messageId, senderId, receiverId) => {
        if ((senderId === currentUserId && receiverId === otherUserId) ||
            (senderId === otherUserId && receiverId === currentUserId)) {
            const msgElem = document.querySelector(`.message[data-message-id="${messageId}"]`);
            if (msgElem) {
                msgElem.remove();
            }
            const container = document.getElementById("messagesContainer");
            if (container && container.querySelectorAll(".message").length === 0) {
                const emptyNotice = document.createElement("div");
                emptyNotice.id = "emptyNotice";
                emptyNotice.className = "empty-conversation-notice";
                emptyNotice.style.cssText = "text-align: center; margin: auto; color: #888;";
                emptyNotice.innerHTML = "<p>No messages yet. Say hello to @otherUser.Username!</p>";
                container.appendChild(emptyNotice);
            }
        }
    });

    connection.start().catch(err => console.error("SignalR connection error:", err));

    // Message Form Submit
    document.getElementById("messageForm").addEventListener("submit", async (e) => {
        e.preventDefault();

        const messageInput = document.getElementById("messageInput");
        const message = messageInput.value.trim();
        const receiverId = document.getElementById("receiverId").value;

        if (message) {
            try {
                const token = localStorage.getItem("xenchat_token");
                const headers = {
                    'Content-Type': 'application/x-www-form-urlencoded',
                };
                if (token) {
                    headers['Authorization'] = 'Bearer ' + token;
                }

                const response = await fetch('/Chat/SendMessage', {
                    method: 'POST',
                    headers: headers,
                    body: `receiverId=${receiverId}&message=${encodeURIComponent(message)}`
                });

                if (response.status === 401) {
                    localStorage.removeItem("xenchat_token");
                    window.location.href = '/Account/Login';
                    return;
                }

                const result = await response.json();
                if (result.success) {
                    await connection.invoke("SendMessage", currentUserId, parseInt(receiverId), message, "@currentUser.Username", result.messageId || 0);
                    messageInput.value = '';
                    messageInput.focus();
                } else {
                    console.error("Server error:", result.error);
                }
            } catch (error) {
                console.error("Error sending message:", error);
            }
        }
    });

    document.getElementById("messageInput").addEventListener("keypress", (e) => {
        if (e.key === "Enter") {
            e.preventDefault();
            document.getElementById("messageForm").dispatchEvent(new Event("submit"));
        }
    });

    // Emoji Picker Implementation
    const emojis = [
        "😀", "😃", "😄", "😁", "😆", "😅", "😂", "🤣", "🥹", "😊", "😇", "🙂", "🙃", "😉", "😌", "😍",
        "🥰", "😘", "😗", "😙", "😚", "😋", "😛", "😝", "😜", "🤪", "🤨", "🧐", "🤓", "😎", "🤩", "🥳",
        "😏", "😒", "😞", "😔", "😟", "😕", "🙁", "😣", "😖", "😫", "😩", "🥺", "😢", "😭", "😤", "😠",
        "😡", "🤬", "🤯", "😳", "🥵", "🥶", "😱", "😨", "😰", "😥", "😓", "🤗", "🤔", "🤭", "🤫", "🤥",
        "😶", "😐", "😑", "😬", "🙄", "😯", "😦", "😧", "😮", "😲", "🥱", "😴", "🤤", "😪", "😵", "🤐",
        "👍", "👎", "👏", "🙌", "🤝", "👊", "✊", "🤛", "🤜", "🤞", "✌️", "🤟", "🤘", "👌", "🤏", "👈",
        "👉", "👆", "👇", "☝️", "✋", "🤚", "🖐️", "🖖", "👋", "🤙", "💪", "🙏", "❤️", "🧡", "💛", "💚",
        "💙", "💜", "🖤", "🤍", "🤎", "💔", "❣️", "💕", "💞", "💓", "💗", "💖", "💘", "💝", "✨", "🔥",
        "💥", "💯", "🎉", "🎊", "🎈", "🚀", "☕", "🍕", "🍻", "🥂", "🍰", "🍩", "🎯", "🎮", "🎵", "🎧"
    ];

    const emojiGrid = document.getElementById("emojiGrid");
    const emojiToggleBtn = document.getElementById("emojiToggleBtn");
    const emojiPickerPopup = document.getElementById("emojiPickerPopup");
    const closeEmojiPickerBtn = document.getElementById("closeEmojiPickerBtn");
    const messageInput = document.getElementById("messageInput");

    if (emojiGrid) {
        emojis.forEach(emoji => {
            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = "emoji-item";
            btn.textContent = emoji;
            btn.addEventListener("click", () => {
                const start = messageInput.selectionStart || messageInput.value.length;
                const end = messageInput.selectionEnd || messageInput.value.length;
                const text = messageInput.value;
                messageInput.value = text.substring(0, start) + emoji + text.substring(end);
                messageInput.selectionStart = messageInput.selectionEnd = start + emoji.length;
                messageInput.focus();
            });
            emojiGrid.appendChild(btn);
        });
    }

    if (emojiToggleBtn && emojiPickerPopup) {
        emojiToggleBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            const isOpen = emojiPickerPopup.style.display === "flex";
            emojiPickerPopup.style.display = isOpen ? "none" : "flex";
        });
    }

    if (closeEmojiPickerBtn && emojiPickerPopup) {
        closeEmojiPickerBtn.addEventListener("click", () => {
            emojiPickerPopup.style.display = "none";
        });
    }

    document.addEventListener("click", (e) => {
        if (emojiPickerPopup && !emojiPickerPopup.contains(e.target) && e.target !== emojiToggleBtn) {
            emojiPickerPopup.style.display = "none";
        }
    });

    // Chat Image Upload Implementation
    const attachImageBtn = document.getElementById("attachImageBtn");
    const chatImageInput = document.getElementById("chatImageInput");
    const chatImageModal = document.getElementById("chatImageModal");
    const chatImagePreview = document.getElementById("chatImagePreview");
    const chatImageCaptionInput = document.getElementById("chatImageCaptionInput");
    const sendChatImageBtn = document.getElementById("sendChatImageBtn");
    const closeChatImageModalBtn = document.getElementById("closeChatImageModalBtn");
    let selectedChatFile = null;

    if (attachImageBtn && chatImageInput) {
        attachImageBtn.addEventListener("click", () => {
            chatImageInput.click();
        });

        chatImageInput.addEventListener("change", function () {
            if (this.files && this.files[0]) {
                selectedChatFile = this.files[0];
                const reader = new FileReader();
                reader.onload = function (e) {
                    chatImagePreview.src = e.target.result;
                    chatImageModal.style.display = "flex";
                    if (chatImageCaptionInput) {
                        chatImageCaptionInput.value = "";
                        chatImageCaptionInput.focus();
                    }
                };
                reader.readAsDataURL(selectedChatFile);
            }
        });
    }

    function closeChatImageModal() {
        if (chatImageModal) chatImageModal.style.display = "none";
        if (chatImageInput) chatImageInput.value = "";
        if (chatImagePreview) chatImagePreview.src = "";
        selectedChatFile = null;
    }

    if (closeChatImageModalBtn) closeChatImageModalBtn.addEventListener("click", closeChatImageModal);
    if (chatImageModal) {
        chatImageModal.addEventListener("click", (e) => {
            if (e.target === chatImageModal) closeChatImageModal();
        });
    }

    if (sendChatImageBtn) {
        sendChatImageBtn.addEventListener("click", async () => {
            if (!selectedChatFile) return;

            sendChatImageBtn.disabled = true;
            sendChatImageBtn.textContent = "Sending...";

            try {
                const formData = new FormData();
                formData.append("receiverId", otherUserId);
                formData.append("imageFile", selectedChatFile);
                if (chatImageCaptionInput && chatImageCaptionInput.value.trim()) {
                    formData.append("caption", chatImageCaptionInput.value.trim());
                }

                const token = localStorage.getItem("xenchat_token");
                const headers = {};
                if (token) headers["Authorization"] = "Bearer " + token;

                const res = await fetch("/Chat/SendImage", {
                    method: "POST",
                    headers: headers,
                    body: formData
                });

                if (res.status === 401) {
                    localStorage.removeItem("xenchat_token");
                    window.location.href = "/Account/Login";
                    return;
                }

                const data = await res.json();
                if (data.success) {
                    await connection.invoke("SendMessage", currentUserId, otherUserId, data.content, "@currentUser.Username", data.messageId || 0);
                    closeChatImageModal();
                } else {
                    alert(data.error || "Failed to send photo");
                }
            } catch (err) {
                console.error("Error sending photo:", err);
                alert("Failed to send photo. Please try again.");
            } finally {
                sendChatImageBtn.disabled = false;
                sendChatImageBtn.textContent = "Send";
            }
        });
    }

    async function deleteMessage(messageId) {
        if (!messageId) return;

        try {
            const token = localStorage.getItem("xenchat_token");
            const headers = {
                'Content-Type': 'application/x-www-form-urlencoded',
            };
            if (token) {
                headers['Authorization'] = 'Bearer ' + token;
            }

            const response = await fetch('/Chat/DeleteMessage', {
                method: 'POST',
                headers: headers,
                body: `messageId=${messageId}`
            });

            if (response.status === 401) {
                localStorage.removeItem("xenchat_token");
                window.location.href = '/Account/Login';
                return;
            }

            const result = await response.json();
            if (result.success) {
                const msgElem = document.querySelector(`.message[data-message-id="${messageId}"]`);
                if (msgElem) {
                    msgElem.remove();
                }
                const container = document.getElementById("messagesContainer");
                if (container && container.querySelectorAll(".message").length === 0) {
                    const emptyNotice = document.createElement("div");
                    emptyNotice.id = "emptyNotice";
                    emptyNotice.className = "empty-conversation-notice";
                    emptyNotice.style.cssText = "text-align: center; margin: auto; color: #888;";
                    emptyNotice.innerHTML = "<p>No messages yet. Say hello to @otherUser.Username!</p>";
                    container.appendChild(emptyNotice);
                }

                if (connection && connection.state === signalR.HubConnectionState.Connected) {
                    await connection.invoke("DeleteMessage", messageId, currentUserId, otherUserId);
                }
            } else {
                alert(result.error || "Failed to delete message");
            }
        } catch (err) {
            console.error("Error deleting message:", err);
            alert("An error occurred while deleting the message.");
        }
    }
    window.deleteMessage = deleteMessage;

    // Toggle Favorite button
    const favBtn = document.getElementById('toggleFavoriteBtn');
    if (favBtn) {
        favBtn.addEventListener('click', async function () {
            const targetId = this.getAttribute('data-target-id');
            if (!targetId) return;

            try {
                const token = localStorage.getItem('xenchat_token');
                const headers = { 'Content-Type': 'application/x-www-form-urlencoded' };
                if (token) headers['Authorization'] = 'Bearer ' + token;

                const res = await fetch('/Chat/ToggleFavorite', {
                    method: 'POST',
                    headers: headers,
                    body: 'targetUserId=' + targetId
                });

                if (res.status === 401) {
                    localStorage.removeItem('xenchat_token');
                    window.location.href = '/Account/Login';
                    return;
                }

                const data = await res.json();
                if (data.success) {
                    const isFav = data.isFavorite;
                    const svg = this.querySelector('svg');
                    const textSpan = document.getElementById('favBtnText');
                    if (isFav) {
                        this.classList.add('active');
                        this.title = 'Remove from Favorites';
                        if (textSpan) textSpan.textContent = 'Remove from Favorites';
                        if (svg) {
                            svg.setAttribute('fill', '#ee4c49');
                            svg.setAttribute('stroke', '#ee4c49');
                        }
                    } else {
                        this.classList.remove('active');
                        this.title = 'Add to Favorites';
                        if (textSpan) textSpan.textContent = 'Add to Favorites';
                        if (svg) {
                            svg.setAttribute('fill', 'none');
                            svg.setAttribute('stroke', 'currentColor');
                        }
                    }

                    // Update sidebar item
                    const sidebarItem = document.querySelector(`.chat-item[data-user-id="${targetId}"]`);
                    if (sidebarItem) {
                        sidebarItem.setAttribute('data-favorite', isFav ? 'true' : 'false');
                    }

                    // Update badge count
                    const badge = document.getElementById('favBadge');
                    if (badge) {
                        badge.textContent = data.count;
                    }

                    // Re-apply filters if currently on favorites tab
                    if (currentFilter === 'favorites') {
                        applyFilters();
                    }
                } else {
                    alert(data.error || 'Failed to update favorite');
                }
            } catch (err) {
                console.error('Error toggling favorite:', err);
            }
        });
    }

    // ============================================================
    // WebRTC Voice Call Logic
    // ============================================================
    let peerConnection = null;
    let localStream = null;
    let isCallInitiator = false;
    let activeCallPartnerId = null;
    let pendingCallerId = null;

    const rtcConfig = {
        iceServers: [
            { urls: 'stun:stun.l.google.com:19302' },
            { urls: 'stun:stun1.l.google.com:19302' }
        ]
    };

    const startVoiceCallBtn = document.getElementById('startVoiceCallBtn');
    const incomingCallModal = document.getElementById('incomingCallModal');
    const incomingCallerName = document.getElementById('incomingCallerName');
    const incomingCallAvatar = document.getElementById('incomingCallAvatar');
    const btnAcceptCall = document.getElementById('btnAcceptCall');
    const btnDeclineCall = document.getElementById('btnDeclineCall');

    const activeCallModal = document.getElementById('activeCallModal');
    const activeCallUserName = document.getElementById('activeCallUserName');
    const activeCallStatus = document.getElementById('activeCallStatus');
    const btnMuteCall = document.getElementById('btnMuteCall');
    const muteBtnLabel = document.getElementById('muteBtnLabel');
    const btnEndCall = document.getElementById('btnEndCall');
    const remoteAudio = document.getElementById('remoteAudio');

    function resetCallState() {
        if (localStream) {
            localStream.getTracks().forEach(track => track.stop());
            localStream = null;
        }
        if (peerConnection) {
            peerConnection.close();
            peerConnection = null;
        }
        if (remoteAudio) {
            remoteAudio.srcObject = null;
        }
        if (activeCallModal) activeCallModal.style.display = 'none';
        if (incomingCallModal) incomingCallModal.style.display = 'none';
        if (btnMuteCall) {
            btnMuteCall.classList.remove('muted');
            if (muteBtnLabel) muteBtnLabel.textContent = 'Mute';
        }
        activeCallPartnerId = null;
        pendingCallerId = null;
        isCallInitiator = false;
    }

    async function createPeerConnection(partnerId) {
        peerConnection = new RTCPeerConnection(rtcConfig);

        peerConnection.onicecandidate = (event) => {
            if (event.candidate && connection.state === signalR.HubConnectionState.Connected) {
                connection.invoke("SendIceCandidate", currentUserId, partnerId, JSON.stringify(event.candidate));
            }
        };

        peerConnection.ontrack = (event) => {
            if (remoteAudio && event.streams && event.streams[0]) {
                remoteAudio.srcObject = event.streams[0];
            }
            if (activeCallStatus) activeCallStatus.textContent = 'Connected (Audio)';
        };

        peerConnection.oniceconnectionstatechange = () => {
            if (peerConnection) {
                if (peerConnection.iceConnectionState === 'disconnected' || peerConnection.iceConnectionState === 'failed') {
                    if (activeCallStatus) activeCallStatus.textContent = 'Connection ' + peerConnection.iceConnectionState;
                }
            }
        };

        localStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
        localStream.getTracks().forEach(track => {
            peerConnection.addTrack(track, localStream);
        });

        return peerConnection;
    }

    // Click Start Voice Call
    if (startVoiceCallBtn) {
        startVoiceCallBtn.addEventListener('click', async () => {
            activeCallPartnerId = otherUserId;
            isCallInitiator = true;

            activeCallModal.style.display = 'flex';
            activeCallUserName.textContent = "@otherUser.Username";
            activeCallStatus.textContent = "Calling @otherUser.Username...";

            if (connection.state === signalR.HubConnectionState.Connected) {
                await connection.invoke("CallUser", currentUserId, otherUserId, "@currentUser.Username");
            }
        });
    }

    // SignalR: Incoming Call
    connection.on("IncomingCall", (callerId, targetUserId, callerName) => {
        if (targetUserId === currentUserId) {
            pendingCallerId = callerId;
            incomingCallerName.textContent = callerName;
            if (incomingCallAvatar) incomingCallAvatar.textContent = callerName.charAt(0).toUpperCase();
            incomingCallModal.style.display = 'flex';
        }
    });

    // Accept Call
    if (btnAcceptCall) {
        btnAcceptCall.addEventListener('click', async () => {
            incomingCallModal.style.display = 'none';
            const callerId = pendingCallerId;
            activeCallPartnerId = callerId;

            activeCallModal.style.display = 'flex';
            activeCallUserName.textContent = incomingCallerName.textContent;
            activeCallStatus.textContent = "Connecting audio...";

            try {
                await createPeerConnection(callerId);
                if (connection.state === signalR.HubConnectionState.Connected) {
                    await connection.invoke("AnswerCall", currentUserId, callerId, true);
                }
            } catch (err) {
                console.error("Microphone access or WebRTC error:", err);
                activeCallStatus.textContent = "Microphone error: " + err.message;
                setTimeout(resetCallState, 3000);
            }
        });
    }

    // Decline Call
    if (btnDeclineCall) {
        btnDeclineCall.addEventListener('click', async () => {
            incomingCallModal.style.display = 'none';
            if (pendingCallerId && connection.state === signalR.HubConnectionState.Connected) {
                await connection.invoke("AnswerCall", currentUserId, pendingCallerId, false);
            }
            pendingCallerId = null;
        });
    }

    // SignalR: Call Answered
    connection.on("CallAnswered", async (answeringUserId, targetUserId, accepted) => {
        if (targetUserId === currentUserId && isCallInitiator) {
            if (!accepted) {
                activeCallStatus.textContent = "Call declined";
                setTimeout(resetCallState, 2000);
            } else {
                activeCallStatus.textContent = "Connecting audio...";
                try {
                    await createPeerConnection(answeringUserId);
                    const offer = await peerConnection.createOffer();
                    await peerConnection.setLocalDescription(offer);

                    if (connection.state === signalR.HubConnectionState.Connected) {
                        await connection.invoke("SendCallOffer", currentUserId, answeringUserId, JSON.stringify(offer));
                    }
                } catch (err) {
                    console.error("WebRTC Offer error:", err);
                    activeCallStatus.textContent = "Connection error: " + err.message;
                    setTimeout(resetCallState, 3000);
                }
            }
        }
    });

    // SignalR: Receive Call Offer
    connection.on("ReceiveCallOffer", async (senderId, receiverId, sdpJson) => {
        if (receiverId === currentUserId && peerConnection) {
            try {
                const offer = JSON.parse(sdpJson);
                await peerConnection.setRemoteDescription(new RTCSessionDescription(offer));
                const answer = await peerConnection.createAnswer();
                await peerConnection.setLocalDescription(answer);

                if (connection.state === signalR.HubConnectionState.Connected) {
                    await connection.invoke("SendCallAnswer", currentUserId, senderId, JSON.stringify(answer));
                }
            } catch (err) {
                console.error("Error answering WebRTC offer:", err);
            }
        }
    });

    // SignalR: Receive Call Answer
    connection.on("ReceiveCallAnswer", async (senderId, receiverId, sdpJson) => {
        if (receiverId === currentUserId && peerConnection) {
            try {
                const answer = JSON.parse(sdpJson);
                await peerConnection.setRemoteDescription(new RTCSessionDescription(answer));
            } catch (err) {
                console.error("Error setting remote answer:", err);
            }
        }
    });

    // SignalR: Receive ICE Candidate
    connection.on("ReceiveIceCandidate", async (senderId, receiverId, candidateJson) => {
        if (receiverId === currentUserId && peerConnection) {
            try {
                const candidate = JSON.parse(candidateJson);
                await peerConnection.addIceCandidate(new RTCIceCandidate(candidate));
            } catch (err) {
                console.error("Error adding ICE candidate:", err);
            }
        }
    });

    // SignalR: Call Ended
    connection.on("CallEnded", (senderId, receiverId) => {
        if ((senderId === currentUserId && receiverId === activeCallPartnerId) ||
            (senderId === activeCallPartnerId && receiverId === currentUserId)) {
            resetCallState();
        }
    });

    // Click End Call
    if (btnEndCall) {
        btnEndCall.addEventListener('click', async () => {
            if (activeCallPartnerId && connection.state === signalR.HubConnectionState.Connected) {
                await connection.invoke("EndCall", currentUserId, activeCallPartnerId);
            }
            resetCallState();
        });
    }

    // Click Mute
    if (btnMuteCall) {
        btnMuteCall.addEventListener('click', () => {
            if (localStream) {
                const audioTracks = localStream.getAudioTracks();
                if (audioTracks.length > 0) {
                    const isMuted = !audioTracks[0].enabled;
                    audioTracks[0].enabled = isMuted; // Toggle enabled
                    if (!audioTracks[0].enabled) {
                        btnMuteCall.classList.add('muted');
                        if (muteBtnLabel) muteBtnLabel.textContent = 'Unmute';
                    } else {
                        btnMuteCall.classList.remove('muted');
                        if (muteBtnLabel) muteBtnLabel.textContent = 'Mute';
                    }
                }
            }
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
        const messagesContainer = document.getElementById('messagesContainer');
        if (messagesContainer) {
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }
    });
</script>