    // SignalR Presence
    connection.on("OnlineUsersList", (onlineIds) => {
        const onlineSet = new Set(onlineIds.map(Number));
        document.querySelectorAll('.avatar-online-badge').forEach(badge => {
            const uid = parseInt(badge.getAttribute('data-user-id'));
            if (onlineSet.has(uid)) {
                badge.classList.add('online');
            } else {
                badge.classList.remove('online');
            }
        });

        const isOtherOnline = onlineSet.has(otherUserId);
        const headerDot = document.getElementById('chatHeaderStatusDot');
        const headerStatus = document.getElementById('chatHeaderStatus');
        if (headerDot && headerStatus) {
            if (isOtherOnline) {
                headerDot.classList.add('online');
                headerStatus.textContent = "Online";
            } else {
                headerDot.classList.remove('online');
                headerStatus.textContent = "Offline";
            }
        }
    });

    connection.on("UserStatusChanged", (userId, isOnline) => {
        document.querySelectorAll(`.avatar-online-badge[data-user-id="${userId}"]`).forEach(badge => {
            if (isOnline) {
                badge.classList.add('online');
            } else {
                badge.classList.remove('online');
            }
        });

        if (userId === otherUserId) {
            const headerDot = document.getElementById('chatHeaderStatusDot');
            const headerStatus = document.getElementById('chatHeaderStatus');
            if (headerDot && headerStatus) {
                if (isOnline) {
                    headerDot.classList.add('online');
                    headerStatus.textContent = "Online";
                } else {
                    headerDot.classList.remove('online');
                    headerStatus.textContent = "Offline";
                }
            }
        }
    });

    connection.start().then(() => {
        if (typeof currentUserId !== 'undefined' && currentUserId > 0) {
            connection.invoke("RegisterUser", currentUserId);
        }
