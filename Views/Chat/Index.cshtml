    window.addEventListener('beforeunload', () => {
        if (connection.state === signalR.HubConnectionState.Connected && typeof currentUserId !== 'undefined' && currentUserId > 0) {
            connection.invoke("SetUserStatus", currentUserId, false);
        }
    });

    // Message Form Submit
    document.getElementById("messageForm").addEventListener("submit", async (e) => {
        e.preventDefault();

        const messageInput = document.getElementById("messageInput");
        const message = messageInput.value.trim();

        if (activeGroupChatId) {
            if (!message) return;
            sendGroupMessage(activeGroupChatId, message);
            messageInput.value = '';
            messageInput.focus();
            return;
        }

        const receiverId = document.getElementById("receiverId").value;

        if (message) {
            try {
                const token = localStorage.getItem("xenchat_token");
                const headers = {
                    'Content-Type': 'application/x-www-form-urlencoded',
                };
                if (token) {
                    headers['Authorization'] = 'Bearer ' + token;
                }

                const response = await fetch('/Chat/SendMessage', {
                    method: 'POST',
                    headers: headers,
                    body: `receiverId=${receiverId}&message=${encodeURIComponent(message)}`
                });

                if (response.status === 401) {
                    localStorage.removeItem("xenchat_token");
                    window.location.href = '/Account/Login';
                    return;
                }

                const result = await response.json();
                if (result.success) {
                    await connection.invoke("SendMessage", currentUserId, parseInt(receiverId), message, "@currentUser.Username", result.messageId || 0);
                    messageInput.value = '';
                    messageInput.focus();
                } else {
                    console.error("Server error:", result.error);
                }
            } catch (error) {
                console.error("Error sending message:", error);
            }
        }
    });

    document.getElementById("messageInput").addEventListener("keypress", (e) => {
