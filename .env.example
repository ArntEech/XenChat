# ==============================================================================
# XenChat Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# IMPORTANT: Never commit the actual '.env' file to source control!
# ==============================================================================

# PostgreSQL Database Connection String
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
ConnectionStrings__DefaultConnection=postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require

# Cloudinary CDN (for profile pictures and 24-hour status stories)
Cloudinary__CloudName=your-cloud-name
Cloudinary__ApiKey=your-api-key
Cloudinary__ApiSecret=your-api-secret

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_REDIRECT_URI=https://xenchat-i4ek.onrender.com/auth/google/callback

# SMTP Email Credentials (for 6-digit OTP verification emails)
EmailSettings__SenderEmail=your-email@gmail.com
EmailSettings__SenderPassword=your-smtp-app-password
